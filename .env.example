# 智谱 GLM API Key (必填，用于 AI 翻译评分和日记润色)
# 获取地址: https://open.bigmodel.cn/usercenter/apikeys
# 不填也能运行，但 AI 功能不可用
GLM_API_KEY=

# GLM 模型名称 (可选，默认 glm-4-flash)
# 可选值: glm-4-flash, glm-4-plus, glm-4, glm-5 等
GLM_MODEL=glm-4-flash

# GLM API 地址 (可选，默认智谱官方地址)
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 服务端口 (可选)
PORT=3001
